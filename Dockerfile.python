# syntax=docker/dockerfile:1
# AgentOS Python — multi-stage image.
# Build stage: install all deps + compile the React SPA.
# Runtime stage: python:3.12-slim + production Python deps + compiled web assets.
# Data (SQLite DB, vault keys, blobs, work dirs) lives in /data.

# ── build: compile React SPA ──────────────────────────────────────────────────
FROM node:22-bookworm-slim AS web-build
ENV PNPM_HOME=/pnpm
RUN npm install -g pnpm@11.7.0
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install Python and build dependencies needed for native modules
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile

COPY apps/web ./apps/web
RUN cd apps/web && pnpm build

# ── runtime ───────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AGENTOS_DATA_DIR=/data \
    PORT=3000

WORKDIR /app

# System deps for cryptography / aiosqlite native extensions.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies (pinned via pyproject.toml).
COPY pyproject.toml ./
RUN pip install --no-cache-dir ".[dev]" 2>/dev/null || pip install --no-cache-dir .

# Application source.
COPY agentos ./agentos

# Compiled React SPA from web-build stage.
COPY --from=web-build /app/apps/web/dist ./apps/web/dist

# Unprivileged user; /data is the only writable path at runtime.
RUN useradd --system --uid 10001 --create-home agentos \
    && mkdir -p /data \
    && chown -R agentos:agentos /data
USER agentos

VOLUME ["/data"]
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; r=urllib.request.urlopen('http://127.0.0.1:${PORT:-3000}/api/health'); exit(0 if r.status==200 else 1)"

CMD ["python", "-m", "agentos.api.server"]
